# Everything goes through index.php; the configuration is never served.
RewriteEngine On
RewriteRule ^(config(\.example)?|voucher|stripe-setup)\.php$ - [F,L]
# The mixing service and the colour charts only answer through index.php.
RewriteRule ^mix/.+\.(php|json|mjs)$ - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]
# The Authorization and signature headers must reach PHP.
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
